import sailpoint.object.ProvisioningResult;
import sailpoint.object.ResourceObject;
import sailpoint.tools.Util;

public class GeoMartTagsVO {
	private Map<String, String> tagsMap = new HashMap<String, String>();
	private Map<String, String> currentTagsMap = new HashMap<String, String>(); 
	
	private Logger logger = Logger.getLogger("com.xxx.geohub");
	
	public GeoMartTagsVO(String nativeId, List<String> tags) {

		if (!Util.isEmpty(tags)) {
			for (String tag : tags) {
				if (Util.isNotNullOrEmpty(tag) && tag.contains(":")) {
					addTag(tag.substring(0, tag.indexOf(":")), tag.substring(tag.indexOf(":")+1));
					currentTagsMap.put(tag.substring(0, tag.indexOf(":")), tag.substring(tag.indexOf(":")+1));
				}
				else if(Util.isNotNullOrEmpty(tag)){
					addTag(tag, null);
					currentTagsMap.put(tag, null);
				}
			}
		}
	}

	public GeoMartTagsVO(String nativeId, ResourceObject resObj) {

		List<String> tagsList = resObj.getStringList("tags");
		if (!Util.isEmpty(tagsList)) {
			for (String tag : tagsList) {
				if (Util.isNotNullOrEmpty(tag) && tag.contains(":")) {
					addTag(tag.substring(0, tag.indexOf(":")), tag.substring(tag.indexOf(":")+1));
					currentTagsMap.put(tag.substring(0, tag.indexOf(":")), tag.substring(tag.indexOf(":")+1));
				}
				else if(Util.isNotNullOrEmpty(tag)) {
					addTag(tag, null);
					currentTagsMap.put(tag, null);
				}
			}
		}
	}

	public void addTag(String key, String value) {
		if(Util.isNotNullOrEmpty(value)) {
			tagsMap.put(key, value.replace(",", "-"));
		}
		else {
			tagsMap.put(key, null);
		}
	}

	public void removeTag(String key) {
		tagsMap.remove(key);
	}
	
	private String generateTagStringForCommit(Map<String, String> inputMap) {
		String tagStr = null; //Start with empty?
		
		TreeMap<String, String> sortedMap = new TreeMap<String, String>();
		sortedMap.putAll(inputMap);
		
		if(!Util.isEmpty(sortedMap)) {			
			for(String eachTagKey : sortedMap.keySet()) {
				if(Util.isNullOrEmpty(tagStr)) {
					tagStr = eachTagKey;
				}
				else {
					tagStr = tagStr+","+eachTagKey;
				}
				
				if(Util.isNotNullOrEmpty(sortedMap.get(eachTagKey))) {
					/* tag value is a csv value, so replace comma with a different character */
					tagStr = tagStr+":"+sortedMap.get(eachTagKey).replace(",", "-");
				}
			}
		}
		logger.debug("generateTagStringForCommit:"+inputMap);
		logger.debug("generateTagStringForCommit ret:"+tagStr);
		return tagStr;
	}
	
		
	public ProvisioningResult commitTags(String baseUrl, String token, String nativeIdentity, ProvisioningResult result) throws IOException, JSONException {
		
		ProvisioningResult retResult = result;
		
		if(retResult == null) {
			retResult = new ProvisioningResult();
			retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
		}
		
		String updateTagStr = generateTagStringForCommit(tagsMap);
		String currentTagStr = generateTagStringForCommit(currentTagsMap);
		
		if(Util.isNotNullOrEmpty(updateTagStr) && updateTagStr.equals(currentTagStr)) {
			logger.debug(nativeIdentity+"=GeoMart tags already uptodate "+currentTagsMap.toString());
			retResult.addWarning("GeoMart tags already uptodate "+currentTagsMap.toString());
			return retResult;
		}
		else if(Util.isNotNullOrEmpty(currentTagStr) && currentTagStr.equals(updateTagStr)) {
			logger.debug(nativeIdentity+"=1GeoMart tags already uptodate "+currentTagsMap.toString());
			retResult.addWarning("GeoMart tags already uptodate "+currentTagsMap.toString());
			return retResult;
		}
		else if(Util.isNotNullOrEmpty(updateTagStr)){
			updateTagStr = updateTagStr.replace("&", "%26");
			logger.debug(nativeIdentity+"=updating:"+updateTagStr);			
		}
		else {
			updateTagStr = ",";
			logger.debug(nativeIdentity+"=removing tags for "+nativeIdentity);	
		}
		
		String reassignContentURL = baseUrl+"/community/users/"+nativeIdentity+"/update?f=json&token="+token+"&tags="+updateTagStr;

		/* START: HTTP call */
		OkHttpClient client = new OkHttpClient();
		MediaType mediaType = MediaType.parse("text/plain");
		
		//RequestBody body = (new MultipartBuilder()).type(MultipartBuilder.FORM).build();
		RequestBody body = RequestBody.create("", mediaType);
		
		Request request = (new Request.Builder()).url(reassignContentURL).method("POST", body).build();
		Response response = client.newCall(request).execute();
		
		/* END: HTTP call */
		
		/*<add sample success response>*/
		if (response != null && 200 == response.code()) {
			String resBody = response.body().string();
			JSONObject responseJson = new JSONObject(resBody);

			if (responseJson.has("success") && responseJson.getBoolean("success") && responseJson.has("username") && nativeIdentity.equalsIgnoreCase(responseJson.getString("username"))) {
				retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
				retResult.addWarning("Added GeoMart Tags: "+updateTagStr);
			}
			else {
				retResult.setStatus(ProvisioningResult.STATUS_FAILED);
				retResult.addError("GeoMart add update failed: "+updateTagStr+", response="+responseJson+"; reassignContentURL="+reassignContentURL);
			}
			logger.debug(nativeIdentity+"=GeoMart: tag response:"+responseJson);
		}
		logger.debug(nativeIdentity+"=GeoMart: tag response: END");

		return retResult;
	}

}
