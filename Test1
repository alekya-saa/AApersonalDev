		if (retResult == null) {
			retResult = new ProvisioningResult();
			retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
		}
		//https://geomartawrrqa.maps.arcgis.com/sharing/rest/content/users/v2rc_geomartawrrqa/items/
		//0174d08876c641d5b0846e7d6f52abd5/reassign?token=<>&targetFolderName=V2RC_geomartawrrqa&targetUsername=MEA_geomartawrrqa&f=json&q=owner:V2RC_geomartawrrqa

		String reassignContentURL = baseUrl + "/content/users/" + getOwner() + "/items/" + getId()
				+ "/reassign?f=json&token=" + token + "&targetFolderName=" + getOwner() + "&targetUsername="
				+ targetUsername+"&q=owner:"+getOwner();
		

		/* START: HTTP call */
		OkHttpClient client = new OkHttpClient();
		MediaType mediaType = MediaType.parse("text/plain");

		// RequestBody body = (new
		// MultipartBuilder()).type(MultipartBuilder.FORM).build();
		RequestBody body = RequestBody.create("", mediaType);

		Request request = (new Request.Builder()).url(reassignContentURL).method("POST", body).build();
		Response response = client.newCall(request).execute();

		/* END: HTTP call */

		/* <add sample success response> */

		if (response != null && 200 == response.code()) {
			String resBody = response.body().string();
			JSONObject responseJson = new JSONObject(resBody);

			if (responseJson.has("success") && responseJson.getBoolean("success")) {
				retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
				retResult.addWarning(
						"Content Reassigned: Title:" + getTitle() + " to " + targetUsername + "@/" + targetFolderName);
			} else {
				retResult.setStatus(ProvisioningResult.STATUS_FAILED);
				retResult.addError("Content Reassignment Failed. Title: " + getTitle() + " to " + targetUsername + "@/"
						+ targetFolderName + ", error:" + responseJson);

			}
		}

		return retResult;
	}

