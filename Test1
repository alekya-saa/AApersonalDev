public class GeoMartUserGroupVO {
	private Logger logger = Logger.getLogger("com.xxx.geohub");
	
	private String owner;
	private String id;
	private boolean updateitemcontrol;
	private String title;
	
	public GeoMartUserGroupVO(JSONObject jsonObject) throws JSONException {
		if(jsonObject!=null && jsonObject.has("id")) {
			setId(jsonObject.getString("id"));
		}
		
		if(jsonObject!=null && jsonObject.has("owner")) {
			setOwner(jsonObject.getString("owner"));
		}
		
		if(jsonObject!=null && jsonObject.has("title")) {
			setTitle(jsonObject.getString("title"));
		}
		if(jsonObject!=null && jsonObject.has("capabilities")) {
			JSONArray capability = jsonObject.getJSONArray("capabilities");
			if(capability.length() > 0) {
				for(int i =0; i < capability.length(); i++) {
					if("updateitemcontrol".equalsIgnoreCase(capability.getString(i))) {
						setUpdateitemcontrol(true);
					}
				}
			}
			
		}
	}
	
	private boolean isUpdateitemcontrol() {
		return updateitemcontrol;
	}

	private void setUpdateitemcontrol(boolean updateitemcontrol) {
		this.updateitemcontrol = updateitemcontrol;
	}
	
	public String getId() {
		return id;
	}

	public void setId(String id) {
		this.id = id;
	}

	public String getOwner() {
		return owner;
	}

	public void setOwner(String owner) {
		this.owner = owner;
	}
	
	public String getTitle() {
		return title;
	}

	private void setTitle(String name) {
		this.title = name;
	}
	
	/*Reassign Groups owned by nativeIdentity
	 * Remove user from groups is the group is has updateitemcontrol=true*/
	public ProvisioningResult reassignUserOwnedGroups(String baseUrl, String token, String nativeIdentity, String targetUsername, ProvisioningResult result) throws IOException, JSONException {
		ProvisioningResult retResult = result;
		if(retResult == null) {
			retResult = new ProvisioningResult();
			retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
		}
		
		logger.debug("START reassignUserOwnedGroupsAndRemoveMemberships for:"+nativeIdentity);
		
		/*Reassign ownership if nativeIdentity is the owner*/
		if(getOwner().equalsIgnoreCase(nativeIdentity)) {
			String reassignGroupURL = baseUrl+"/community/groups/"+getId()+"/reassign?token="+token+"&f=json&targetUsername="+targetUsername;
			/* START: HTTP call */
			OkHttpClient client = new OkHttpClient();
			MediaType mediaType = MediaType.parse("text/plain");
			
			//RequestBody body = (new MultipartBuilder()).type(MultipartBuilder.FORM).build();
			RequestBody body = RequestBody.create("", mediaType);
			
			Request request = (new Request.Builder()).url(reassignGroupURL).method("POST", body).build();
			Response response = client.newCall(request).execute();
			/* END: HTTP call */
			
			/*<add sample success response>*/
			if (response != null && 200 == response.code()) {
				String resBody = response.body().string();
				JSONObject responseJson = new JSONObject(resBody);
				
				logger.debug("removeUserMemberships reassigning for:"+targetUsername+"; group="+this.getTitle()+";"+this.getId()+"\n responseJSON="+responseJson);
				
				if (responseJson.has("success") && responseJson.getBoolean("success")) {
					retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
					retResult.addWarning("GeoMart Group Ownership Reassigned: Title="+this.getTitle()+" name="+"; from "+nativeIdentity+" to "+targetUsername);
				}
				else {
					retResult.setStatus(ProvisioningResult.STATUS_FAILED);
					retResult.addError("GeoMart Group Ownership Reassignment Failed: Group:" +this.getTitle()+"; from "+nativeIdentity+" to "+targetUsername+", responseJson="+responseJson);
				}
			}
		}

		return retResult;
	}
	
	/*Reassign Groups owned by nativeIdentity
	 * Remove user from groups is the group is has updateitemcontrol=true*/
	public ProvisioningResult removeGroupMemberships(String baseUrl, String token, String nativeIdentity, String targetUsername, ProvisioningResult result) throws IOException, JSONException {
		ProvisioningResult retResult = result;
		if(retResult == null) {
			retResult = new ProvisioningResult();
			retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
		}
		
		logger.debug("START removeGroupMemberships for:"+nativeIdentity);

		if(isUpdateitemcontrol()) {
			/*Remove user from the group if isUpdateitemcontrol()==true*/
			//String removeGroupMembershipURL = https://geomartawrrqa.maps.arcgis.com/sharing/rest/community/groups/e5faaa3691734da7bbcbc710f7ec3973/removeUsers;
			String removeGroupMembershipURL = baseUrl+"/community/groups/"+getId()+"/removeUsers";

			/* START: HTTP call */
			OkHttpClient client = new OkHttpClient();
			
			RequestBody body = new FormBody.Builder()
					.add("users", nativeIdentity)
					.add("f", "json")
					.add("token", token)
					.build();

			Request request = (new Request.Builder()).url(removeGroupMembershipURL).method("POST", body).build();
			Response response = client.newCall(request).execute();
			/* END: HTTP call */
			
			/*<add sample success response>*/
			if (response != null && 200 == response.code()) {
				String resBody = response.body().string();
				JSONObject responseJson = new JSONObject(resBody);
				
				logger.debug("removeUserMemberships isUpdateitemcontrol for:"+nativeIdentity+"; group="+this.getTitle()+";"+this.getId()+"\n responseJSON="+responseJson);
				
				if (responseJson.has("success") && responseJson.getBoolean("success")) {
					retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
					retResult.addWarning("GeoMart Group membership removed: "+getTitle());
				}
				else if(responseJson.has("notRemoved") && responseJson.getJSONArray("notRemoved").length()==0) {
					retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
					retResult.addWarning("GeoMart Group membership removed: "+getTitle());
				}
				else {
					retResult.setStatus(ProvisioningResult.STATUS_FAILED);
					retResult.addError("GeoMart Group membership removal Failed: "+getTitle()+" to "+targetUsername+"; responseJson="+responseJson);
				}
			}
			else {
				retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
				retResult.addWarning("GeoMart Group membership not removed or reassigned: "+getTitle()+" to "+targetUsername);
			}
			/*Other group memberships can remain*/
		}

		return retResult;
	}

	@Override
	public String toString() {
		return "GeoMartUserGroupVO [owner=" + owner + ", id=" + id + ", updateitemcontrol=" + updateitemcontrol
				+ ", name=" + title + "]\n";
	}
	
	@Override
	public int hashCode() {
		int hash = 6;
		hash = 85 * hash + (getTitle() != null ? (int) UUID.nameUUIDFromBytes(getId().getBytes()).getMostSignificantBits() : 0);
		return hash;
	}
	
	@Override
	public boolean equals(Object obj) {
		if(obj == null) {
			return false;
		}
		else if(obj instanceof GeoMartUserGroupVO && this.getId() == ((GeoMartUserGroupVO) obj).getId()) {
			return true;
		}else {
			return false;
		}
	}
}
