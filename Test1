	/*
	 * requestID is identityRequest name, always check whether the entitlement is
	 * provisioned.
	 */
	@Override
	public RequestResult getRequestStatus(String requestID) throws Exception {
		logger.debug("Application in getRequestStatus= _config" + ", requestID=" + requestID);

		/* set STATUS_IN_PROCESS by default */
		RequestResult reqResult = new RequestResult();
		reqResult.setStatus(RequestResult.STATUS_IN_PROCESS);
		reqResult.setRequestID(requestID);

		/* requestID is always IdentityRequest name for GeoHub */
		if (Util.isNotNullOrEmpty(requestID)) { // Toggle BreakPoint (TB=1)
			Filter identityRequestFilter = Filter.eq("name", requestID);
			QueryOptions identityRequestQo = new QueryOptions();
			identityRequestQo.add(identityRequestFilter);

			IdentityRequest identityRequest = null;
			WorkItem workItem = null;

			if (context.countObjects(IdentityRequest.class, identityRequestQo) == 1) {
				identityRequest = context.getObjectByName(IdentityRequest.class, requestID);
			} else if (context.countObjects(WorkItem.class, identityRequestQo) == 1) {
				workItem = context.getObjectByName(WorkItem.class, requestID);
			}

			if (identityRequest != null) {
				List<IdentityRequestItem> identityRequestItems = identityRequest.getItems();

				boolean aggregated = false;

				for (IdentityRequestItem eachItem : identityRequestItems) {

					if (Util.isNotNullOrEmpty(requestID) && requestID.equals(eachItem.getProvisioningRequestId()) && !aggregated) {
						this.application = this.context.getObjectByName(Application.class, eachItem.getApplication());
						aggregated = (aggregateSingleAccount(eachItem.getNativeIdentity())) != null ? true : false;
					}

					Link geomartLink = null;

					if (aggregated) {
						IdentityService idSrv = new IdentityService(this.context);
						if (idSrv.countLinks(this.context.getObjectById(Identity.class, identityRequest.getTargetId()), this.application) > 0) {
							geomartLink = idSrv.getLink(context.getObjectById(Identity.class, identityRequest.getTargetId()), this.application, null,
									eachItem.getNativeIdentity());
						}

					}

					boolean isEntitlement = ("userLicenseTypeId".equals(eachItem.getName())) ? true : false;
					logger.debug("getRequestStatus: " + requestID + ", isEntitlement:" + isEntitlement);

					if (isEntitlement && geomartLink != null) {
						QueryOptions qo = new QueryOptions();
						qo.setResultLimit(1);
						qo.setOrderBy("created");
						qo.setOrderAscending(false);

						Filter filter = Filter.and(Filter.eq("application.name", this.application.getName()), Filter.eq("name", eachItem.getName()),
								Filter.eq("value", eachItem.getValue()));
						qo.addFilter(filter);

						IdentityService idSrv = new IdentityService(context);
						if (idSrv.countLinks(context.getObjectById(Identity.class, identityRequest.getTargetId()),
								context.getObjectByName(Application.class, this.application.getName())) > 0) {

							if (eachItem.getValue().equals(geomartLink.getAttribute("userLicenseTypeId"))) {
								reqResult.setStatus(RequestResult.STATUS_COMMITTED);
							} else {
								logger.debug("else getRequestStatus: " + requestID + ", isEntitlement:" + isEntitlement + ", eachItem.getOperation()="
										+ eachItem.getOperation() + ", geomartLink.getAttribute(\"userLicenseTypeId\")="
										+ geomartLink.getAttribute("userLicenseTypeId"));
							}
						} else {
							logger.debug("no geomart account getRequestStatus: " + requestID + ", isEntitlement:" + isEntitlement + ", eachItem.getOperation()="
									+ eachItem.getOperation());
						}

					} else if (geomartLink != null && eachItem.getValue() != null && eachItem.getValue().equals(geomartLink.getAttribute(eachItem.getName()))) {
						reqResult.setStatus(RequestResult.STATUS_COMMITTED);
					} else {
						logger.debug("11getRequestStatus: " + requestID + ", isEntitlement:" + isEntitlement + ", eachItem.getOperation()="
								+ eachItem.getOperation() + ", name=" + eachItem.getName());
					}
				}
				// context.decache(identityRequest);
			}
		}
		logger.debug("END Application in getRequestStatus= reqResult=" + reqResult.getStatus() + ", requestID=" + requestID);
		return reqResult;
	}

	/* Aggregate the account and update the link */
	public ResourceObject aggregateSingleAccount(String nativeIdentity) throws GeneralException {

		Connector appConnector = ConnectorFactory.getConnector(this.application, null);
		ResourceObject resObj = null;
		try {
			resObj = appConnector.getObject("account", nativeIdentity, null);
		} catch (ConnectorException e) {
			/* Dont throw */
			e.printStackTrace();
			logger.debug("Error in aggregateSingleAccount:" + e.getMessage());
		}

		Attributes aggArgs = new Attributes();
		aggArgs.put("noAttributePromotion", "true");
		aggArgs.put("promoteAttributes", "false");
		aggArgs.put("correlateEntitlements", "false");
		aggArgs.put("noOptimizeReaggregation", "false");
		aggArgs.put("externalHandlerSeparateThread", "false");
		aggArgs.put("correlateOnly", "true");

		logger.debug("GeoMart aggregateSingleAccount, ResourceObject=" + XMLObjectFactory.getInstance().toXml(resObj));

		return resObj;
	}

