		ProvisioningResult retResult = result;
		if (retResult == null) {
			retResult = new ProvisioningResult();
			retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
		}
		//https://geomartawrrqa.maps.arcgis.com/sharing/rest/content/users/v2rc_geomartawrrqa/items/
