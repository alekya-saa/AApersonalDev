public class GeoMartUserGroupsVO {

	private Logger logger = Logger.getLogger("com.xxx.geohub");
	
	private boolean hasMore;
	private int total;
	private int nextStart;
	private List<GeoMartUserGroupVO> userGroupMemberships = new ArrayList<GeoMartUserGroupVO>();
	private List<GeoMartUserGroupVO> userOwnedGroups = new ArrayList<GeoMartUserGroupVO>();
	private String nativeIdentity;

	public GeoMartUserGroupsVO(String nativeIdentity, String baseUrl, String token)
			throws IOException, JSONException, GeneralException {
		setNativeIdentity(nativeIdentity);
		setUserGroups(baseUrl, token);
	}

	public boolean isHasMore() {
		return hasMore;
	}

	private void setHasMore(boolean hasMore) {
		this.hasMore = hasMore;
	}

	public int getTotal() {
		return total;
	}

	private void setTotal(int total) {
		this.total = total;
	}

	public int getNextStart() {
		return nextStart;
	}

	private void setNextStart(int nextStart) {
		this.nextStart = nextStart;
		if (nextStart == -1) {
			setHasMore(false);
		} else {
			setHasMore(true);
		}
	}

	public List<GeoMartUserGroupVO> getUserGroupMemberships() {
		return userGroupMemberships;
	}

	private void addUserGroupMembership(JSONObject jsonObject) throws JSONException {
		userGroupMemberships.add(new GeoMartUserGroupVO(jsonObject));
	}

	public List<GeoMartUserGroupVO> getUserOwnedGroups() {
		return userOwnedGroups;
	}

	private void addUserOwnedGroup(JSONObject jsonObject) throws JSONException {
		userOwnedGroups.add(new GeoMartUserGroupVO(jsonObject));
	}

	public String getNativeIdentity() {
		return nativeIdentity;
	}

	private void setNativeIdentity(String nativeIdentity) {
		this.nativeIdentity = nativeIdentity;
	}

	public ProvisioningResult removeUserMemberships(String baseUrl, String token,
			String targetUsername, ProvisioningResult result) throws IOException, JSONException {
		ProvisioningResult retResult = result;
		logger.debug("START removeUserMemberships for:"+getNativeIdentity());
		
		if (Util.nullSafeSize(getUserGroupMemberships()) > 0) {
			for (GeoMartUserGroupVO eachGroup : getUserGroupMemberships()) {
				logger.debug("removeUserMemberships removing for:"+getNativeIdentity()+"; group="+eachGroup.getTitle()+";"+eachGroup.getId());
				
				retResult = eachGroup.removeGroupMemberships(baseUrl, token, getNativeIdentity(),
						targetUsername, retResult);
			}
		}

		return retResult;
	}
	
	public ProvisioningResult reassignAllUserOwnedGroups(String baseUrl, String token,
			String targetUsername, ProvisioningResult result) throws IOException, JSONException {
		ProvisioningResult retResult = result;
		logger.debug("START reassignAllUserOwnedGroups for:"+targetUsername);
		
		if (Util.nullSafeSize(getUserOwnedGroups()) > 0) {
			for (GeoMartUserGroupVO eachGroup : getUserOwnedGroups()) {
				logger.debug("reassignAllUserOwnedGroups removing for:"+targetUsername+"; group="+eachGroup.getTitle()+";"+eachGroup.getId());
				retResult = eachGroup.reassignUserOwnedGroups(baseUrl, token, getNativeIdentity(),
						targetUsername, retResult);				
			}
		}

		return retResult;
	}

	private void setUserGroups(String baseUrl, String token) throws IOException, JSONException, GeneralException {
		setNextStart(1);

		while (isHasMore()) {
			getUserGroupMemberships(baseUrl, token);
		}

		// Reset nextStart to get owned groups
		setNextStart(1);

		while (isHasMore()) {
			getUserOwnedGroups(baseUrl, token);
		}
	}

	/* Get user group memberships */
	private void getUserGroupMemberships(String baseUrl, String token)
			throws IOException, JSONException, GeneralException {
		// https://geomartawrrqa.maps.arcgis.com/sharing/rest/community/groups?searchUserAccess=groupMember&searchUserName=A9AE_geomartawrrqa2&f=json&token=<token>

		String getGroupsURL = baseUrl + "/community/groups?f=json&searchUserAccess=groupMember&searchUserName="
				+ getNativeIdentity() + "&token=" + token + "&num=100" + "&start=" + getNextStart();

		/* START: HTTP call */
		OkHttpClient client = new OkHttpClient();
		MediaType mediaType = MediaType.parse("text/plain");

		RequestBody body = RequestBody.create("", mediaType);

		Request request = (new Request.Builder()).url(getGroupsURL).method("POST", body).build();
		Response response = client.newCall(request).execute();
		/* END: HTTP call */

		/* <add sample success response> */
		if (response != null && 200 == response.code()) {
			String resBody = response.body().string();
			JSONObject responseJson = new JSONObject(resBody);

			if (responseJson != null && responseJson.has("total")) {
				setTotal(responseJson.getInt("total"));
			}
			if (responseJson != null && responseJson.has("nextStart")) {
				setNextStart(responseJson.getInt("nextStart"));
			}
			if (responseJson != null && responseJson.has("results")) {
				JSONArray resultsArray = responseJson.getJSONArray("results");
				for (int i = 0; i < resultsArray.length(); i++) {
					addUserGroupMembership(resultsArray.getJSONObject(i));
				}
			}

			if (responseJson != null && responseJson.has("error")) {
				throw new GeneralException(responseJson.toString());
			}
		}
	}

	/* Get user owned groups */
	private void getUserOwnedGroups(String baseUrl, String token) throws IOException, JSONException {
		// https://geomartawrrqa.maps.arcgis.com/sharing/rest/community/groups?searchUserAccess=groupMember&searchUserName=A9AE_geomartawrrqa2&f=json&token=<token>

		String getUserOwnedGroupsURL = baseUrl + "/community/groups?f=json&q=owner:" + getNativeIdentity() + "&token="
				+ token + "&num=100" + "&start=" + getNextStart();

		/* START: HTTP call */
		OkHttpClient client = new OkHttpClient();

		Request request = (new Request.Builder()).url(getUserOwnedGroupsURL).method("GET", null).build();
		Response response = client.newCall(request).execute();
		/* END: HTTP call */

		/* <add sample success response> */
		if (response != null && 200 == response.code()) {
			String resBody = response.body().string();
			JSONObject responseJson = new JSONObject(resBody);
			addUserOwnedGroups(responseJson);
		}
	}

	public void addUserOwnedGroups(JSONObject jsonObject) throws JSONException {
		if (jsonObject != null && jsonObject.has("total")) {
			setTotal(jsonObject.getInt("total"));
		}
		if (jsonObject != null && jsonObject.has("nextStart")) {
			setNextStart(jsonObject.getInt("nextStart"));
		}
		if (jsonObject != null && jsonObject.has("results")) {
			JSONArray resultsArray = jsonObject.getJSONArray("results");
			for (int i = 0; i < resultsArray.length(); i++) {
				addUserOwnedGroup(resultsArray.getJSONObject(i));
			}
		}
	}

	@Override
	public String toString() {
		return "GeoHubUserGroupsVO [userGroupMemberships=" + userGroupMemberships + ",\n userOwnedGroups="
				+ userOwnedGroups + ",\n nativeIdentity=" + nativeIdentity + "]";
	}

}
