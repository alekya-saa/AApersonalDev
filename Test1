
import sailpoint.object.IdentityRequest;
import sailpoint.object.Attributes;
import java.util.List;
import java.util.Map;

String requestId = "0000000115";

IdentityRequest request = context.getObjectByName(
    IdentityRequest.class,
    requestId
);

if (request == null) {
    return false;
}

Attributes attributes = request.getAttributes();

if (attributes == null) {
    return false;
}

Object summariesObject = attributes.get("approvalSummaries");

if (!(summariesObject instanceof List)) {
    return false;
}

List summaries = (List) summariesObject;

for (Object summary : summaries) {

    Object state = null;

    if (summary instanceof Map) {
        state = ((Map) summary).get("state");
    } else if (summary != null) {
        try {
            state = summary.getClass()
                .getMethod("getState", new Class[0])
                .invoke(summary, new Object[0]);
        } catch (Exception e) {
            return false;
        }
    }

    if (state != null &&
        "Rejected".equalsIgnoreCase(String.valueOf(state))) {
        return true;
    }
}

return false;
