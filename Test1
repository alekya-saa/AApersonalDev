	public ProvisioningResult updateUserLicenseType(String baseUrl, String token, String nativeIdentity, String userLicenseType, ProvisioningResult result) throws IOException, JSONException {
		ProvisioningResult retResult = result;
		
		logger.debug("START updateUserLicenseType to:"+userLicenseType+", for:"+nativeIdentity);
		if (retResult == null) {
			retResult = new ProvisioningResult();
			retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
		}

		String updateLicenseTypeURL = baseUrl + "/portals/self/updateUserLicenseType?f=json";
//https://geomartcloud-enterprise-dev.nonprod.xxx.com/portal/sharing/rest/portals/self/updateUserLicenseType?f=json
		
//https://geomartcloud-enterprise-dev.nonprod.xxx.com/portal/sharing/rest/portals/self/invite?token=QXrQ7OQ8uBUpM8RcizDa-6ywPi7aDiPBlxdfv22gwjSEUHAhD89uQCYx3y6xoKFeaNKoV3cIpBQ9iEGd7tv-CFZmwtNMebLIywycN7DnQv1YO_gBcVH7FHLuEWM0IiLxEhNXoRq2eMkMOsFR1ftt0g..&f=json
		
		/* START: HTTP call */
		OkHttpClient client = new OkHttpClient();

		RequestBody body = new FormBody.Builder()
				.add("userLicenseType", userLicenseType)
				.add("users", "[\""+nativeIdentity+"\"]")
				.add("token", token).build();

		Request request = (new Request.Builder()).url(updateLicenseTypeURL).method("POST", body).build();
		Response response = client.newCall(request).execute();
		/* END: HTTP call */

		/* <add sample success response> */

		if (response != null && 200 == response.code()) {
			String resBody = response.body().string();
			JSONObject responseJson = new JSONObject(resBody);
			logger.debug("updateUserLicenseType response: for:"+nativeIdentity+"; response="+responseJson);
			
			if (responseJson != null && responseJson.has("results") && responseJson.getJSONArray("results").length() == 1) {
				JSONArray resultsArray = responseJson.getJSONArray("results");
				if(resultsArray.getJSONObject(0).has("status") && resultsArray.getJSONObject(0).getBoolean("status")) {
					retResult.addWarning("userLicenseType updated: "+userLicenseType+", response=" + responseJson);
				}
				else {
					retResult.addWarning("userLicenseType Not updated: "+userLicenseType+", response=" + responseJson);
					retResult.setStatus(ProvisioningResult.STATUS_RETRY);
				}
			}else {
				retResult.setStatus(ProvisioningResult.STATUS_RETRY);
				retResult.addError("userLicenseType update failed " + userLicenseType+ "MEA will retry, error:" + responseJson);
			}
		}
		else if (response != null && 200 != response.code()) {
			JSONObject responseJson = new JSONObject(response.body().string());
			retResult.addError(responseJson.toString());
			retResult.setStatus(ProvisioningResult.STATUS_FAILED);
		}
		else {
			retResult.addError("Endpoint: "+updateLicenseTypeURL+" failed.");
			retResult.setStatus(ProvisioningResult.STATUS_FAILED);
		}

		return retResult;
	}
	

