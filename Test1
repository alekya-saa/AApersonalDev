	@Override
	public ProvisioningResult provision(ProvisioningPlan plan) throws Exception {
		this.plan = plan;
		logger.debug("GeoMart ,provisioning plan=" + XMLObjectFactory.getInstance().toXml(plan));

		List<AccountRequest> acctRequests = plan.getAccountRequests();
		Iterator<AccountRequest> acctReqItr = acctRequests.iterator();

		/* Create the result and initialize */
		ProvisioningResult result = new ProvisioningResult();
		result.setStatus(ProvisioningResult.STATUS_COMMITTED);

		boolean retryIOException = false;
		
		while (acctReqItr != null && acctReqItr.hasNext()) {
			AccountRequest acctReq = acctReqItr.next();

			this.application = this.context.getObjectByName(Application.class, acctReq.getApplicationName());

			if (AccountRequest.Operation.Create.equals(acctReq.getOperation())) {
				logger.debug("calling create()");
				try {
					result = create(plan.getIdentity(), acctReq, result);
				} catch (IOException ioe) {
					result.setStatus(ProvisioningResult.STATUS_RETRY);
					result.addError("MEA to retry: " + ioe + ", ErrorMessage: " + ioe.getMessage());
					logger.error("MEA to retry: " + ioe.toString());
					ioe.printStackTrace();
					retryIOException = true;
				} catch (JSONException je) {
					result.setStatus(ProvisioningResult.STATUS_FAILED);
					result.addError("MEA to retry: " + je + ", ErrorMessage: " + je.getMessage());
					logger.error("MEA to retry: " + je.toString());
					je.printStackTrace();
				}

			} else if (AccountRequest.Operation.Modify.equals(acctReq.getOperation())) {
				logger.debug("calling modify()");
				result.setStatus(ProvisioningResult.STATUS_COMMITTED);
				try {
					result = modify(plan.getIdentity(), acctReq, result);
				} catch (IOException ioe) {
					result.setStatus(ProvisioningResult.STATUS_RETRY);
					result.addError("MEA to retry: " + ioe + ", ErrorMessage: " + ioe.getMessage());
					retryIOException = true;
				} catch (JSONException je) {
					result.setStatus(ProvisioningResult.STATUS_FAILED);
					result.addError("MEA to retry: " + je + ", ErrorMessage: " + je.getMessage());
				}

			}else {
				result.addError(this.application+" operation not allowed in IntegrationConfig. Op="+acctReq.getOperation());
			}

		}
		
		if(!result.isCommitted() && !retryIOException) {			
			result.setStatus(ProvisioningResult.STATUS_FAILED);
		}

		return result;
	}

	private ProvisioningResult modify(Identity targetId, AccountRequest acctReq, ProvisioningResult result)
			throws GeneralException, JSONException, ConnectorException, IOException {
		ProvisioningResult retResult = result;

		if (retResult == null) {
			retResult = new ProvisioningResult();
		}

		String requestID = generateRequestId();
		if (Util.isNotNullOrEmpty(requestID)) {
			retResult.setRequestID(requestID);
		}

		Iterator<ProvisioningPlan.AttributeRequest> attrReqItr = acctReq.getAttributeRequests().iterator();
		String nativeIdentity = null;
		if (acctReq.getNativeIdentity() != null) {
			nativeIdentity = acctReq.getNativeIdentity();
		}

		/* disable the account if hasAppOp = false */
		boolean hasAddOp = false;
		boolean tagsUpdated = false;

		while (attrReqItr != null && attrReqItr.hasNext()) {
			ProvisioningPlan.AttributeRequest attrReq = attrReqItr.next();
			String name = attrReq.getName();
			Object val = attrReq.getValue();
			if (val != null && val instanceof String && Util.isNotNullOrEmpty(val.toString())) {

				if (ProvisioningPlan.Operation.Add.equals(attrReq.getOperation()) && ("userLicenseTypeId".equals(name) || "userLicenseType".equals(name))) {

					/* Enable if Account is Disabled For ADD */
					ResourceObject previousResObj = aggregateSingleAccount(nativeIdentity);
					if (previousResObj != null && "true".equalsIgnoreCase(previousResObj.getStringAttribute("disabled"))) {
						retResult = enableAccount(retResult);
						
						/* get latest ResourceObject */
						previousResObj = aggregateSingleAccount(nativeIdentity);
					}

					hasAddOp = true;

					String userLicenseType = val.toString();

					String baseUrl = getBaseUrl();
					String targetAccount = this.application.getStringAttributeValue("geomart_username");
					String targetFolder = nativeIdentity;
					
					GeoMartUserVO previousGeomartUser = new GeoMartUserVO(nativeIdentity, baseUrl, getToken(), previousResObj, true);

					GeoMartUserVO geomartUser = new GeoMartUserVO(nativeIdentity, baseUrl, getToken(), previousResObj, true);

					if(previousResObj != null && userLicenseType.equals(previousResObj.getStringAttribute("userLicenseTypeId"))) {
						/* continue if requested entitlement is already on the account */
						logger.debug("User license is already " + userLicenseType);
					}
					else if ("creatorUT".equalsIgnoreCase(userLicenseType)) {
						/*
						 * change the licensetype if license is changed to creator, dont need removing
						 * group memberships
						 */
						geomartUser = new GeoMartUserVO(nativeIdentity, baseUrl, getToken(), false);

						retResult = geomartUser.updateUserLicenseType(baseUrl, getToken(), nativeIdentity, userLicenseType, retResult);

					} else {
						geomartUser = new GeoMartUserVO(nativeIdentity, baseUrl, getToken(), true);

						retResult = geomartUser.getUserGroups().reassignAllUserOwnedGroups(baseUrl, getToken(), targetAccount, retResult);

						geomartUser = new GeoMartUserVO(nativeIdentity, baseUrl, getToken(), true);

						retResult = geomartUser.getUserGroups().removeUserMemberships(baseUrl, getToken(), targetAccount, retResult);

						geomartUser = new GeoMartUserVO(nativeIdentity, baseUrl, getToken(), true);

						// retResult =
						// geomartUser.getUserAddOnLicenses().removeAllAddOnLicenses(baseUrl,
						// getToken(), retResult);

						retResult = geomartUser.getUserContents().reassignAllContents(baseUrl, getToken(), targetAccount, targetFolder, retResult);

					}

					String roleId = getRoleFromLicense(val.toString());
					
					if (retResult.isCommitted()) {
						/*
						 * update ROLE after contents, groups are reassigned. Attempt to change the
						 * license even if there is a failure
						 */
						GeoMartUserRoleVO geoHubUserRoleVO = new GeoMartUserRoleVO();
						
						retResult = geoHubUserRoleVO.updateUserRole(baseUrl, getToken(), nativeIdentity, roleId, retResult);
						retResult = geomartUser.updateUserLicenseType(baseUrl, getToken(), nativeIdentity, userLicenseType, retResult);

						ResourceObject currentResObj = aggregateSingleAccount(nativeIdentity);

						geomartUser = new GeoMartUserVO(nativeIdentity, baseUrl, getToken(), currentResObj, true);
						retResult = sendEmail(previousGeomartUser, geomartUser, retResult);
					} else if (retResult.isRetry()) {
						/* update ROLE after contents, groups are reassigned */
						GeoMartUserRoleVO geoHubUserRoleVO = new GeoMartUserRoleVO();
						
						retResult = geoHubUserRoleVO.updateUserRole(baseUrl, getToken(), nativeIdentity, roleId, retResult);

						retResult = geomartUser.updateUserLicenseType(baseUrl, getToken(), nativeIdentity, userLicenseType, retResult);

						ResourceObject currentResObj = aggregateSingleAccount(nativeIdentity);
						geomartUser = new GeoMartUserVO(nativeIdentity, baseUrl, getToken(), currentResObj, true);
						retResult = sendEmail(previousGeomartUser, geomartUser, retResult);
					} else {
						/*
						 * update ROLE after contents, groups are reassigned Attempt to change the
						 * license even if there is a failure
						 */
						GeoMartUserRoleVO geoHubUserRoleVO = new GeoMartUserRoleVO();
						
						retResult = geoHubUserRoleVO.updateUserRole(baseUrl, getToken(), nativeIdentity, roleId, retResult);
						retResult = geomartUser.updateUserLicenseType(baseUrl, getToken(), nativeIdentity, userLicenseType, retResult);

						ResourceObject currentResObj = aggregateSingleAccount(nativeIdentity);

						geomartUser = new GeoMartUserVO(nativeIdentity, baseUrl, getToken(), currentResObj, true);
						retResult = sendEmail(previousGeomartUser, geomartUser, retResult);
					}
				} else if (ProvisioningPlan.Operation.Remove.equals(attrReq.getOperation())
						&& ("userLicenseTypeId".equals(name) || "userLicenseType".equals(name)) && !hasAddOp) {
					/* 1/12/2023: Disable account on Remove Operation */
					retResult = disableAccount(retResult);
				} else {
					ResourceObject retResObj = aggregateSingleAccount(nativeIdentity);
					logger.debug("Adding tags=" + nativeIdentity + ";tagsUpdated=" + tagsUpdated);
					if (!tagsUpdated && retResObj != null && acctReq.getNativeIdentity().equals(retResObj.getIdentity())) {
						retResult.setObject(retResObj);

						GeoMartTagsVO tagsVO = new GeoMartTagsVO(acctReq.getNativeIdentity(), retResObj);

						if (targetId != null && targetId.getManager() != null && Util.isNotNullOrEmpty(targetId.getManager().getEmail())) {
							tagsVO.addTag("manager", targetId.getManager().getEmail());
						} else {
							tagsVO.removeTag("manager");
						}

						if (targetId != null && Util.isNotNullOrEmpty(targetId.getStringAttribute("department"))) {
							tagsVO.addTag("department", targetId.getStringAttribute("department").replace(",", "-"));
						} else {
							tagsVO.removeTag("department");
						}

						if (targetId != null && Util.isNotNullOrEmpty(targetId.getStringAttribute("lobDisplayName"))) {
							tagsVO.addTag("lobDisplayName", targetId.getStringAttribute("lobDisplayName").replace(",", "-"));
						} else {
							tagsVO.removeTag("lobDisplayName");
						}
						logger.debug("commiting Adding tags=" + nativeIdentity);
						retResult = tagsVO.commitTags(getBaseUrl(), getToken(), acctReq.getNativeIdentity(), retResult);
						tagsUpdated = true;
					}
					
				}

			}
		}

		return retResult;
	}

	/* Creates the account and returns ProvisioningResult */
	private synchronized ProvisioningResult create(Identity targetId, ProvisioningPlan.AccountRequest acctReq, ProvisioningResult result)
			throws JSONException, IOException, GeneralException, ConnectorException {
		ProvisioningResult retResult = result;

		logger.debug("Create Nativeid=" + acctReq.getNativeIdentity());

		ResourceObject retResObjForID = aggregateSingleAccount(acctReq.getNativeIdentity());
		if (retResObjForID != null && retResObjForID.getIdentity() != null) {
			retResult.addWarning(acctReq.getNativeIdentity() + " account already exists in " + application.getName());
			retResult.setStatus(retResult.STATUS_COMMITTED);
			return retResult;
		}

		Iterator<ProvisioningPlan.AttributeRequest> attrReqItr = acctReq.getAttributeRequests().iterator();

		/* Build the body for Create EndPoint */
		StringBuffer requestBodyStrBuffer = new StringBuffer();

		/* Add nativeidentity */
		if (Util.isNotNullOrEmpty(acctReq.getNativeIdentity())) {
			requestBodyStrBuffer.append("username=" + acctReq.getNativeIdentity());
		}

		while (attrReqItr != null && attrReqItr.hasNext()) {
			ProvisioningPlan.AttributeRequest attrReq = attrReqItr.next();
			String name = attrReq.getName();
			Object val = attrReq.getValue();
			if (val != null && val instanceof String && Util.isNotNullOrEmpty(val.toString())) {
				if (requestBodyStrBuffer.length() > 0) {
					requestBodyStrBuffer.append("&");
				}

				if ("userLicenseTypeId".equals(name) || "userLicenseType".equals(name)) {
					requestBodyStrBuffer.append("userLicenseTypeId=" + val.toString());
					requestBodyStrBuffer.append("&role=" + getRoleFromLicense(val.toString()));
				} else {
					requestBodyStrBuffer.append(name + "=" + val.toString());
				}
			}

		}

		/* START: HTTP call for Create */
		OkHttpClient client = new OkHttpClient();
		MediaType mediaType = MediaType.parse("application/x-www-form-urlencoded");
		
		RequestBody body = RequestBody.create(requestBodyStrBuffer.toString(), mediaType);
		
		Request request = new Request.Builder()
							.url(getUrlForCreate())
							.addHeader("Referer", "https://" + this.application.getStringAttributeValue("geomart_hostname") + "/portal")
							.addHeader("Content-Type", "application/x-www-form-urlencoded")
							.post(body)
							.build();

		this.logger.debug("body==" + requestBodyStrBuffer.toString());

		Response response = client.newCall(request).execute();
		/* END: HTTP call for Create */

		if (response != null) {
			String resBody = response.body().string();
			this.logger.debug("resBody==" + resBody);

			JSONObject responseJson = new JSONObject(resBody);
			retResult.setRequestID(generateRequestId());

			if (responseJson.has("status") && "success".equalsIgnoreCase(responseJson.getString("status"))) {
				retResult.addWarning(this.application.getName() + " Create response=" + responseJson.toString());
				/* Account created, set result status to committed */
				retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);

				ResourceObject retResObj = aggregateSingleAccount(acctReq.getNativeIdentity());

				/* Update tags */
				if (retResObj != null && acctReq.getNativeIdentity().equals(retResObj.getIdentity())) {
					retResult.setObject(retResObj);

					GeoMartTagsVO tagsVO = new GeoMartTagsVO(acctReq.getNativeIdentity(), retResObj);

					if (targetId != null && targetId.getManager() != null && Util.isNotNullOrEmpty(targetId.getManager().getEmail())) {
						tagsVO.addTag("manager", targetId.getManager().getEmail());
					} else {
						tagsVO.removeTag("manager");
					}

					if (targetId != null && Util.isNotNullOrEmpty(targetId.getStringAttribute("department"))) {
						tagsVO.addTag("department", targetId.getStringAttribute("department"));
					} else {
						tagsVO.removeTag("department");
					}

					if (targetId != null && Util.isNotNullOrEmpty(targetId.getStringAttribute("lobDisplayName"))) {
						tagsVO.addTag("lobDisplayName", targetId.getStringAttribute("lobDisplayName"));
					} else {
						tagsVO.removeTag("lobDisplayName");
					}

					retResult = tagsVO.commitTags(getBaseUrl(), getToken(), acctReq.getNativeIdentity(), retResult);

				} else {
					retResult.setStatus(ProvisioningResult.STATUS_FAILED);
				}
			} else {
				retResult.setStatus(ProvisioningResult.STATUS_FAILED);
				retResult.addError(this.application.getName() + "; create response = " + responseJson.toString());
			}
		} else {
			retResult.setStatus(ProvisioningResult.STATUS_FAILED);
			retResult.addError("Create Response from " + this.application.getName() + " is null");
		}

		this.logger.debug("retResult=" + retResult.toXml());
		return retResult;
	}

	/* Generate the token by calling test connection, token is valid for 2hr */
	private String getToken() throws GeneralException, ConnectorException {
		if (this.application == null) {
			throw new GeneralException("Failed to construct an instance of connector  in getToken()");
		} else {
			Connector appConnector = ConnectorFactory.getConnector(this.application, null);

			if (appConnector == null) {
				throw new GeneralException("Failed to construct an instance of connector in getToken()");
			}

			Date expiry = (application.getAttributeValue("expires") != null) ? application.getDateAttributeValue("expires") : null;
			Calendar cal = Calendar.getInstance();
			cal.add(Calendar.MINUTE, -10);

			Calendar expiryCal = Calendar.getInstance();
			expiryCal.setTime(expiry);
			if (cal.after(expiryCal)) {
				appConnector.testConfiguration();
				/* get the fresh application instance */
				this.application = context.getObjectByName(Application.class, application.getName());
			}

			this.token = this.application.getStringAttributeValue("token");
		}

		return this.token;
	}

	/* Get the baseUrl from app xml */
	private String getBaseUrl() throws GeneralException, ConnectorException {
		if (this.application != null) {
			return this.application.getStringAttributeValue("genericWebServiceBaseUrl");
		} else {
			throw new ConnectorException("Application is null in getBaseUrl()");
		}
	}

	/* Get the baseUrl + contextUrl for create from app xml */
	private String getUrlForCreate() throws GeneralException, ConnectorException {
		String hostname = this.application.getStringAttributeValue("geomart_hostname");

		String createUrl = "https://" + hostname
				+ "/portal/portaladmin/security/users/createUser?f=json&token=REPLACENEWTOKEN".replace("REPLACENEWTOKEN", getToken());

		this.logger.debug("getUrlForCreate=" + createUrl);
		return createUrl;
	}

	/* Get the baseUrl + contextUrl for create from app xml */
	private String generateRequestId() throws JSONException, GeneralException {
		String requestID = null;
		Attributes planArgs = plan.getArguments();
		if (planArgs != null) {
			String source = (String) planArgs.get(ProvisioningPlan.ARG_SOURCE);
			String identityRequestId = (String) planArgs.get("identityRequestId");
			String requester = (String) planArgs.get("requester");
			logger.debug("source value: " + source);
			logger.debug("identityRequestId value: " + identityRequestId);
			requestID = identityRequestId;
		}

		logger.debug("generateRequestId()==" + requestID);

		return requestID;
	}

	private String getRoleFromLicense(String userLicenseType) {
		String ret = this.application.getStringAttributeValue(userLicenseType);

		if (Util.isNullOrEmpty(ret)) {
			ret = this.application.getStringAttributeValue("defaultRole");
			if (Util.isNullOrEmpty(ret)) {
				ret = "iAAAAAAAAAAAAAAA";
			}
		}

		return ret;
	}

	/* disableAccount() : Disable account */
	private ProvisioningResult disableAccount(ProvisioningResult result) throws GeneralException {
		ProvisioningResult retResult = result;
		ProvisioningPlan attrAssignmentsPlan = new ProvisioningPlan();
		attrAssignmentsPlan.setIdentity(plan.getIdentity());

		Iterator<AccountRequest> acctItr = plan.getAccountRequests().iterator();

		while (acctItr.hasNext()) {
			AccountRequest acctReq = acctItr.next();

			/* Disable for Modify only */
			if (AccountRequest.Operation.Modify.equals(acctReq.getOperation())) {
				AccountRequest attrAssignmentAcctReq = new AccountRequest(AccountRequest.Operation.Disable, acctReq.getApplicationName(), null,
						acctReq.getNativeIdentity());
				attrAssignmentsPlan.add(attrAssignmentAcctReq);
				Provisioner provisioner = new Provisioner(context);
				provisioner.execute(attrAssignmentsPlan);

				retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
				retResult.addWarning(
						"Disabled account:" + acctReq.getApplicationName() + "/" + acctReq.getNativeIdentity());
			}
		}

		return retResult;
	}

	/* enableAccount() : Enable account */
	private ProvisioningResult enableAccount(ProvisioningResult result) throws GeneralException {
		ProvisioningResult retResult = result;
		ProvisioningPlan attrAssignmentsPlan = new ProvisioningPlan();
		attrAssignmentsPlan.setIdentity(plan.getIdentity());

		Iterator<AccountRequest> acctItr = plan.getAccountRequests().iterator();

		while (acctItr.hasNext()) {
			AccountRequest acctReq = acctItr.next();

			if (AccountRequest.Operation.Modify.equals(acctReq.getOperation())) {
				AccountRequest attrAssignmentAcctReq = new AccountRequest(AccountRequest.Operation.Enable, acctReq.getApplicationName(), null,
						acctReq.getNativeIdentity());
				attrAssignmentsPlan.add(attrAssignmentAcctReq);

				Provisioner provisioner = new Provisioner(context);
				ProvisioningProject pr = provisioner.compile(attrAssignmentsPlan);

				provisioner.execute(attrAssignmentsPlan);

				ResourceObject retResObj = aggregateSingleAccount(acctReq.getNativeIdentity());
				if (retResObj != null && "false".equalsIgnoreCase(retResObj.getStringAttribute("disabled"))) {
					retResult.addWarning("enabled account:" + acctReq.getApplicationName() + "/" + acctReq.getNativeIdentity());

					retResult.setStatus(ProvisioningResult.STATUS_COMMITTED);
				} else {
					retResult.addWarning("enabled failed for account:" + acctReq.getApplicationName() + "/" + acctReq.getNativeIdentity());
					retResult.setStatus(ProvisioningResult.STATUS_FAILED);
				}
			}
		}

		return retResult;
	}

	private ProvisioningResult sendEmail(GeoMartUserVO previousAccount, GeoMartUserVO currentAccount, ProvisioningResult result) throws GeneralException {

		logger.debug("sendEmail currentAccount= " + currentAccount);
		logger.debug("sendEmail previousAccount= " + previousAccount);

		ProvisioningResult retResult = result;
		
		/* Dont send email if license didnt change */
		if(previousAccount == null || currentAccount == null || previousAccount.getUserLicenseTypeId() == null || previousAccount.getUserLicenseTypeId().equals(currentAccount.getUserLicenseTypeId())) {
			return retResult;
		}

		EmailTemplate emailTemplate = context.getObjectByName(EmailTemplate.class, emailTemplateName);

		boolean isUpdated = false;

		if (retResult == null || !retResult.isCommitted() || emailTemplate == null) {
			if (retResult != null) {
				retResult.addError("GeoMart User email not sent");
			}
			return retResult;
		} else if (previousAccount != null && currentAccount != null && previousAccount.getUserLicenseTypeId() != null
				&& !previousAccount.getUserLicenseTypeId().equalsIgnoreCase(currentAccount.getUserLicenseTypeId())) {
			isUpdated = true;
		}

		Map mailArgs = new HashMap();
		mailArgs.put("appName",this.application.getName());
		
		GeoMartUserVO tempPreviousAccount = previousAccount;

		logger.debug("previousAccount=" + previousAccount);
		logger.debug("currentAccount=" + currentAccount);
		if (tempPreviousAccount != null && Util.isNotNullOrEmpty(tempPreviousAccount.getFullName())) {
			mailArgs.put("identityDisplayName", tempPreviousAccount.getFullName());
		} else if (currentAccount != null && Util.isNotNullOrEmpty(currentAccount.getFullName())) {
			mailArgs.put("identityDisplayName", currentAccount.getFullName());
		} else if (tempPreviousAccount != null && Util.isNotNullOrEmpty(tempPreviousAccount.getFirstName())) {
			mailArgs.put("identityDisplayName", currentAccount.getFirstName());
		} else {
			mailArgs.put("identityDisplayName", "User");
		}

		/* Get the groupmembership differences */
		if (tempPreviousAccount != null && tempPreviousAccount.getUserGroups() != null
				&& !Util.isEmpty(tempPreviousAccount.getUserGroups().getUserGroupMemberships())) {
			Iterator<GeoMartUserGroupVO> previousAccountGrpMembershipsItr = tempPreviousAccount.getUserGroups().getUserGroupMemberships().iterator();
			while (previousAccountGrpMembershipsItr != null && previousAccountGrpMembershipsItr.hasNext()) {
				GeoMartUserGroupVO previousAccountGrp = previousAccountGrpMembershipsItr.next();

				Iterator<GeoMartUserGroupVO> currentAccountGrpMembershipsItr = currentAccount.getUserGroups().getUserGroupMemberships().iterator();
				while (currentAccountGrpMembershipsItr != null && currentAccountGrpMembershipsItr.hasNext()) {
					GeoMartUserGroupVO currentAccountGrp = currentAccountGrpMembershipsItr.next();
					if (currentAccountGrp.getId().equalsIgnoreCase(previousAccountGrp.getId())) {
						previousAccountGrpMembershipsItr.remove();
					}
				}

				Util.flushIterator(currentAccountGrpMembershipsItr);
			}

			Util.flushIterator(previousAccountGrpMembershipsItr);

			if (Util.nullSafeSize(tempPreviousAccount.getUserGroups().getUserGroupMemberships()) > 0) {
				mailArgs.put("groupMemberships", tempPreviousAccount.getUserGroups().getUserGroupMemberships());
				isUpdated = true;
			} else {
				mailArgs.put("groupMemberships", null);
			}
		} else {
			mailArgs.put("groupMemberships", null);
		}

		/* Get the group ownership differences */
		if (tempPreviousAccount != null && tempPreviousAccount.getUserGroups() != null
				&& !Util.isEmpty(tempPreviousAccount.getUserGroups().getUserOwnedGroups())) {
			Iterator<GeoMartUserGroupVO> previousAccountGrpsOwnedItr = tempPreviousAccount.getUserGroups().getUserOwnedGroups().iterator();
			while (previousAccountGrpsOwnedItr != null && previousAccountGrpsOwnedItr.hasNext()) {
				GeoMartUserGroupVO previousAccountOwnedGrp = previousAccountGrpsOwnedItr.next();

				Iterator<GeoMartUserGroupVO> currentAccountGrpsOwnedItr = currentAccount.getUserGroups().getUserOwnedGroups().iterator();
				while (currentAccountGrpsOwnedItr != null && currentAccountGrpsOwnedItr.hasNext()) {
					GeoMartUserGroupVO currentAccountOwnedGrp = currentAccountGrpsOwnedItr.next();
					if (currentAccountOwnedGrp.getId().equalsIgnoreCase(previousAccountOwnedGrp.getId())) {
						previousAccountGrpsOwnedItr.remove();
					}
				}

				Util.flushIterator(currentAccountGrpsOwnedItr);
			}

			Util.flushIterator(previousAccountGrpsOwnedItr);

			if (Util.nullSafeSize(tempPreviousAccount.getUserGroups().getUserOwnedGroups()) > 0) {
				mailArgs.put("groupsOwned", tempPreviousAccount.getUserGroups().getUserOwnedGroups());
				isUpdated = true;
			} else {
				mailArgs.put("groupsOwned", null);
			}
		} else {
			mailArgs.put("groupsOwned", null);
		}

		/*
		 * if (previousAccount != null && previousAccount.getUserAddOnLicenses() !=
		 * null) { mailArgs.put("addOnLicenses",
		 * previousAccount.getUserAddOnLicenses().getAddOnLicenses()); } else {
		 * mailArgs.put("addOnLicenses", null); }
		 */

		mailArgs.put("previousLicenseType", previousAccount.getUserLicenseTypeId());
		mailArgs.put("currentLicenseType", currentAccount.getUserLicenseTypeId());

		if (previousAccount != null && previousAccount.getUserContents() != null && !Util.isEmpty(previousAccount.getUserContents().getContents())) {
			mailArgs.put("contents", previousAccount.getUserContents().getContents());
			isUpdated = true;
		} else {
			mailArgs.put("contents", null);
		}

		EmailOptions options = new EmailOptions();
		options.setTo(previousAccount.getEmail());
		// options.setCc("");
		options.setVariables(mailArgs);
		options.setSendImmediate(true); // hidden magic not listed in the 8.0 API
		options.setNoRetry(true);

		logger.debug("sendEmail= mailArgs:" + mailArgs.toString());
		try {
			if (isUpdated) {
				context.sendEmailNotification(emailTemplate, options);
				retResult.addWarning("GeoMart email sent to " + previousAccount.getEmail());
			} else {
				retResult.addWarning("GeoMart email NOT sent to " + previousAccount.getEmail());
			}

		} catch (GeneralException ge) {
			retResult.addWarning("MEA failed to send email to geohub user, username=" + previousAccount.getUsername() + "; email:" + currentAccount.getEmail());
		}

		return retResult;
	}

}
